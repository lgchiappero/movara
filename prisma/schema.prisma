generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  paymentId     String?
  paymentMethod String
  address       Json
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  image     String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String?
  dni       String?
  telefono  String
  email     String?
  provincia String?
  mensaje   String?
  createdAt DateTime @default(now())

  // Para la alerta de "leads sin respuesta hace más de 48hs" del dashboard
  // — no existía ninguna noción de respuesta hasta ahora.
  contactado   Boolean   @default(false)
  contactadoEn DateTime?

  // ─── Pipeline de ventas simplificado (/admin/pipeline) ──────────────
  etapa         String  @default("nuevo") // nuevo | en_contacto | propuesta_enviada | ganado | perdido
  origen        String? // web | instagram | whatsapp | email_directo | referido | cliente_recurrente
  // Modelo de interés declarado al cargar el lead manualmente desde
  // /admin/pipeline — mismos valores que Unidad.modelo (MODELOS_UNIDAD) más
  // "Varios"; null = "Sin definir". No tiene relación formal con Unidad.
  modeloInteres String?
  vendedorId    String? // referencia a AdminUser.id — sin relación formal en Prisma
  // (AdminUser no tiene FK entrante desde acá) para no acoplar el borrado
  // de un usuario a las filas de leads que tuvo asignadas.
  notasVenta    String?
  motivoPerdida String? // solo tiene sentido si etapa = "perdido"
  clienteId     String? // referencia a Cliente.id una vez convertido — mismo criterio sin FK formal
  valorEstimado Float?

  pedidos ConfiguracionPedido[]

  @@map("leads")
}

model ConfiguracionPedido {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId          String?
  lead            Lead?   @relation(fields: [leadId], references: [id])
  clienteNombre   String
  clienteEmail    String?
  clienteWhatsapp String?

  // Especificación del producto — capturada de punta a punta por el
  // configurador visual (/configurador), un único flujo con fotos.
  modelo String? // "10ft" | "20ft" | "40ft"

  finalidad String? // "inversor" | "agro" | "vivienda" | "turismo" | "empresa" | "sector-publico"
  provincia String?
  localidad String?

  habitaciones  Int?
  incluyeCocina Boolean @default(true)
  tipoCocina    String? // "electrico" | "gas"
  incluyeBano   Boolean @default(true)
  tipoAgua      String? // "calefon-electrico" | "termotanque-gas"
  lavarropas    String? // "sin" | "bano" | "cocina" | "externo"

  // Selecciones de materiales con foto — Record<selectorKey, optionId|null>,
  // ver MATERIAL_CATEGORY_GROUPS en src/components/configurador/StepMateriales.tsx
  materiales Json?
  upgrades   String[] @default([])

  // Notas adicionales del cliente sobre la configuración del espacio,
  // cargadas manualmente por el admin (pedidos sin configurador público).
  notasConfiguracion String?

  tipoCliente    String? // "particular" | "empresa"
  razonSocial    String?
  nombreContacto String?

  precioEstimado Float? // snapshot de calcularPrecio() al momento del envío

  // ─── Gestión del pedido (post-venta) ──────────────────────
  numeroConsulta      String? // formato MOV-CONSULTA-{AÑO}-{NRO 3 dígitos}, generado al enviar el configurador
  numeroPedido        String? // formato MOV-{AÑO}-{NRO 3 dígitos}, generado al confirmar
  estadoPedido        String    @default("consulta") // "consulta" | "presupuestado" | "confirmado" | "en_produccion" | "en_transito" | "en_aduana" | "entregado"
  precioFinal         Float?
  anticipo            Float?
  saldoPendiente      Float?
  numeroFabrica       String?
  numeroContenedor    String?
  numeroBL            String?
  fechaConfirmacion   DateTime?
  fechaProduccion     DateTime?
  fechaDespacho       DateTime?
  fechaArriboEstimado DateTime?
  fechaEntrega        DateTime?
  notasInternas       String?
  notasCliente        String?

  // ─── Costos internos (nunca visibles para el cliente) ─────
  costoProveedor   Float?
  costoFlete       Float?
  costoAduana      Float?
  costoOtros       Float?
  costoTotal       Float?
  margenUSD        Float?
  margenPorcentaje Float?

  // ─── Gestión comercial ─────────────────────────────────────
  vendedorAsignado String? // email del vendedor responsable (AdminUser.email)
  piProveedor      String? // número de PI (Proforma Invoice) del proveedor
  piUrl            String? // path del documento PI en Supabase Storage
  fechaPIPagado    DateTime?
  montoPI          Float?

  // ─── Comprobantes de pago ──────────────────────────────────
  comprobantePagoUrl  String? // path del comprobante de anticipo
  comprobanteSaldoUrl String? // path del comprobante de saldo

  // ─── Logística y aduana ─────────────────────────────────────
  seguroTransporte  Boolean @default(false)
  seguroUrl         String? // path de la póliza
  inspeccionFabrica Boolean @default(false)
  inspeccionUrl     String? // path del informe de inspección
  fotosDespachadas  Boolean @default(false)
  fotosUrl          String? // path o carpeta con fotos de despacho
  notasDespachador  String?
  gastosDespachante Float?
  impuestosAduana   Float?
  gastosPortuarios  Float?

  // ─── Entrega e instalación ──────────────────────────────────
  costoGruaDescarga    Float?
  costoTransporteLocal Float?
  instalacionFecha     DateTime?
  instalacionNotas     String?
  satisfaccionCliente  String?

  // ─── Garantía MOVARA (12 meses) ─────────────────────────────
  garantiaActivada    Boolean   @default(false)
  garantiaFechaInicio DateTime?
  garantiaFechaFin    DateTime? // calculada server-side = garantiaFechaInicio + 12 meses

  documentos DocumentoPedido[]

  @@map("configuraciones_pedido")
}

model DocumentoPedido {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  pedidoId String
  pedido   ConfiguracionPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tipo   String // "comprobante_pago" | "pi_proveedor" | "bl" | "otro"
  nombre String // nombre descriptivo del documento
  url    String // path del archivo en Supabase Storage
  notas  String?

  subidoPor String // email del admin/vendedor que lo subió

  @@map("documentos_pedido")
}

model AdminUser {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nombre      String
  email       String    @unique
  password    String // hash bcrypt
  rol         String    @default("vendedor") // "admin" | "vendedor"
  activo      Boolean   @default(true)
  ultimoLogin DateTime?

  @@map("admin_users")
}

// ─── Agenda de visitas al showroom ──────────────────────────────
model Cita {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fecha   DateTime // fecha del turno, guardada a medianoche UTC (date-only)
  horario String // "10:00" | "11:00" | "12:00" | "15:00" | "16:00" | "17:00"
  estado  String   @default("confirmada") // "confirmada" | "cancelada" | "completada"

  tipoCliente String // "particular" | "empresa"
  nombre      String
  email       String
  telefono    String
  razonSocial String?
  consulta    String // breve descripción de qué busca

  canceladaPor      String? // "cliente" | "admin"
  motivoCancelacion String?

  recordatorioEnviado Boolean @default(false)

  @@index([fecha, horario])
  @@map("citas")
}

model DisponibilidadAgenda {
  id         String   @id @default(cuid())
  fecha      DateTime @unique // date-only, medianoche UTC
  habilitada Boolean  @default(true)
  horarios   String[] // subconjunto de HORARIOS_AGENDA disponible ese día

  @@map("disponibilidad_agenda")
}

// ─── Gestión de envíos y unidades ───────────────────────────────
model Cliente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre    String
  dni       String?
  cuit      String?
  domicilio String?
  email     String?
  telefono  String?
  notas     String?

  unidades Unidad[]

  @@map("clientes")
}

model Envio {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numeroPI         String? // Proforma Invoice del proveedor
  numeroBL         String? // Bill of Lading
  numeroContenedor String?

  fechaEmbarque       DateTime?
  fechaArriboEstimado DateTime?
  fechaArribo         DateTime?

  costoPI                 Float? // costo total de la PI en USD
  costoFlete              Float? // flete internacional
  costoSeguro             Float? // seguro de carga
  costoAduana             Float? // gastos aduaneros
  costoOtrosInternacional Float? // otros costos internacionales

  notas String?

  unidades        Unidad[]
  documentos      DocumentoEnvio[]
  costosLogistica CostoLogistica[]

  @@map("envios")
}

model Unidad {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numeroUnidad String? // MOV-UNIDAD-2026-001

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  envioId   String?
  envio     Envio?  @relation(fields: [envioId], references: [id])

  // ─── Configuración del producto ────────────────────────────
  modelo        String? // "Flex 18" | "Flex 38" | "Flex 77"
  configuracion Json? // configuración completa de la unidad
  precioCliente Float? // precio acordado con el cliente en USD

  // ─── Estado de fabricación (individual por unidad) ─────────
  estadoFabricacion String @default("pendiente")
  // pendiente | en_produccion | produccion_completa | embarcado |
  // en_transito | en_aduana | en_destino | entregado

  // ─── Logística nacional (individual por unidad) ────────────
  provinciaDestino        String?
  localidadDestino        String?
  direccionEntrega        String?
  costoTransporteNacional Float?
  costoGrua               Float?
  fechaEntregaEstimada    DateTime?
  fechaEntrega            DateTime?

  // ─── Garantía ────────────────────────────────────────────────
  garantiaActivada Boolean   @default(false)
  garantiaInicio   DateTime?
  garantiaFin      DateTime?

  notas String?

  documentos          DocumentoUnidad[]
  acuerdosPago        AcuerdoPago[]
  prorrateosLogistica ProrrateoLogistica[]

  @@map("unidades")
}

model DocumentoEnvio {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  envioId String
  envio   Envio  @relation(fields: [envioId], references: [id])

  seccion     String // "04_produccion" | "05_embarque" | "06_despacho"
  nombre      String
  descripcion String?
  url         String
  tipo        String? // mime type

  subidoPor String

  @@map("documentos_envio")
}

model DocumentoUnidad {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  unidadId String
  unidad   Unidad @relation(fields: [unidadId], references: [id])

  seccion     String // "01_cliente" | "02_contrato" | "03_pagos" | "07_entrega" | "08_garantia" | "09_reclamos"
  nombre      String
  descripcion String?
  url         String
  tipo        String?

  subidoPor String

  @@map("documentos_unidad")
}

// ─── Cobranza contable ───────────────────────────────────────────────────

model AcuerdoPago {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidadId String
  unidad   Unidad @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  tipo          String // "cobro" | "pago"
  concepto      String // cobro: "venta" / pago: "fabrica"|"flete"|"aduana"|"despachante"|"transporte"|"grua"|"impuestos"|"otro"
  descripcion   String?
  contraparte   String // cobro: nombre del cliente / pago: nombre del proveedor
  moneda        String // "ARS" | "USD"
  totalAcordado Float

  cuotas      Cuota[]
  movimientos Movimiento[]

  notas         String?
  registradoPor String

  @@map("acuerdos_pago")
}

model Cuota {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  acuerdoId String
  acuerdo   AcuerdoPago @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)

  descripcion String // "Anticipo 30%", "Saldo 70%", "Cuota 1/3", etc.
  importe     Float
  vencimiento DateTime?
  estado      String    @default("pendiente") // "pendiente" | "pagado" | "vencido"

  movimientos Movimiento[]

  @@map("cuotas")
}

model Movimiento {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  acuerdoId String
  acuerdo   AcuerdoPago @relation(fields: [acuerdoId], references: [id], onDelete: Cascade)
  cuotaId   String? // opcional — puede saldar una cuota específica o ser pago parcial
  cuota     Cuota?      @relation(fields: [cuotaId], references: [id], onDelete: SetNull)

  fecha          DateTime
  importe        Float
  modalidad      String // "transferencia" | "efectivo" | "cripto" | "otro"
  comprobanteUrl String?
  notas          String?
  registradoPor  String

  @@map("movimientos")
}

model CierrePeriodo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  mes       Int // 1-12
  anio      Int

  cerradoPor String // email del admin
  notas      String?

  totalCobradoUSD Float @default(0)
  totalCobradoARS Float @default(0)
  totalPagadoUSD  Float @default(0)
  totalPagadoARS  Float @default(0)
  margenUSD       Float @default(0)

  @@unique([mes, anio])
  @@map("cierres_periodo")
}

model TipoCambio {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  fecha     DateTime

  usdArs Float // cotización USD → ARS del día
  fuente String? // "oficial" | "blue" | "manual"

  cargadoPor String

  @@map("tipos_cambio")
}

// ─── Logística internacional (por envío, no por unidad) ───────────────
// Costos del contenedor completo: flete marítimo, seguro, aduana, etc. Se
// pagan una vez por envío; opcionalmente se prorratean entre las unidades
// del envío (un ProrrateoLogistica por unidad) para la rentabilidad.
model CostoLogistica {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  envioId String
  envio   Envio  @relation(fields: [envioId], references: [id], onDelete: Restrict)

  concepto       String // "flete" | "seguro" | "aduana" | "despachante" | "portuarios" | "vep" | "otro"
  descripcion    String?
  moneda         String // "USD" | "ARS"
  importe        Float
  fecha          DateTime // fecha de pago (o prevista, si está pendiente)
  estado         String // "pagado" | "pendiente"
  comprobanteUrl String?
  notas          String?
  prorrateado    Boolean  @default(false)
  registradoPor  String

  prorrateos ProrrateoLogistica[]

  @@index([envioId])
  @@map("costos_logistica")
}

model ProrrateoLogistica {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  costoId  String
  costo    CostoLogistica @relation(fields: [costoId], references: [id], onDelete: Cascade)
  unidadId String
  unidad   Unidad         @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  importe Float // parte de la unidad, en la moneda del costo

  @@unique([costoId, unidadId])
  @@index([unidadId])
  @@map("prorrateos_logistica")
}
