generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  paymentId     String?
  paymentMethod String
  address       Json
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  image     String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String?
  dni       String?
  telefono  String
  email     String?
  provincia String?
  mensaje   String?
  createdAt DateTime @default(now())

  pedidos ConfiguracionPedido[]

  @@map("leads")
}

model ConfiguracionPedido {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId          String?
  lead            Lead?   @relation(fields: [leadId], references: [id])
  clienteNombre   String
  clienteEmail    String?
  clienteWhatsapp String?

  // Especificación del producto — capturada de punta a punta por el
  // configurador visual (/configurador), un único flujo con fotos.
  modelo String? // "10ft" | "20ft" | "40ft"

  finalidad String? // "inversor" | "agro" | "vivienda" | "turismo" | "empresa" | "sector-publico"
  provincia String?
  localidad String?

  habitaciones  Int?
  incluyeCocina Boolean @default(true)
  tipoCocina    String? // "electrico" | "gas"
  incluyeBano   Boolean @default(true)
  tipoAgua      String? // "calefon-electrico" | "termotanque-gas"
  lavarropas    String? // "sin" | "bano" | "cocina" | "externo"

  // Selecciones de materiales con foto — Record<selectorKey, optionId|null>,
  // ver MATERIAL_CATEGORY_GROUPS en src/components/configurador/StepMateriales.tsx
  materiales Json?
  upgrades   String[] @default([])

  // Notas adicionales del cliente sobre la configuración del espacio,
  // cargadas manualmente por el admin (pedidos sin configurador público).
  notasConfiguracion String?

  tipoCliente    String? // "particular" | "empresa"
  razonSocial    String?
  nombreContacto String?

  precioEstimado Float? // snapshot de calcularPrecio() al momento del envío

  // ─── Gestión del pedido (post-venta) ──────────────────────
  numeroConsulta      String? // formato MOV-CONSULTA-{AÑO}-{NRO 3 dígitos}, generado al enviar el configurador
  numeroPedido        String? // formato MOV-{AÑO}-{NRO 3 dígitos}, generado al confirmar
  estadoPedido        String    @default("consulta") // "consulta" | "presupuestado" | "confirmado" | "en_produccion" | "en_transito" | "en_aduana" | "entregado"
  precioFinal         Float?
  anticipo            Float?
  saldoPendiente      Float?
  numeroFabrica       String?
  numeroContenedor    String?
  numeroBL            String?
  fechaConfirmacion   DateTime?
  fechaProduccion     DateTime?
  fechaDespacho       DateTime?
  fechaArriboEstimado DateTime?
  fechaEntrega        DateTime?
  notasInternas       String?
  notasCliente        String?

  // ─── Costos internos (nunca visibles para el cliente) ─────
  costoProveedor   Float?
  costoFlete       Float?
  costoAduana      Float?
  costoOtros       Float?
  costoTotal       Float?
  margenUSD        Float?
  margenPorcentaje Float?

  // ─── Gestión comercial ─────────────────────────────────────
  vendedorAsignado String? // email del vendedor responsable (AdminUser.email)
  piProveedor      String? // número de PI (Proforma Invoice) del proveedor
  piUrl            String? // path del documento PI en Supabase Storage
  fechaPIPagado    DateTime?
  montoPI          Float?

  // ─── Comprobantes de pago ──────────────────────────────────
  comprobantePagoUrl  String? // path del comprobante de anticipo
  comprobanteSaldoUrl String? // path del comprobante de saldo

  // ─── Logística y aduana ─────────────────────────────────────
  seguroTransporte  Boolean @default(false)
  seguroUrl         String? // path de la póliza
  inspeccionFabrica Boolean @default(false)
  inspeccionUrl     String? // path del informe de inspección
  fotosDespachadas  Boolean @default(false)
  fotosUrl          String? // path o carpeta con fotos de despacho
  notasDespachador  String?
  gastosDespachante Float?
  impuestosAduana   Float?
  gastosPortuarios  Float?

  // ─── Entrega e instalación ──────────────────────────────────
  costoGruaDescarga    Float?
  costoTransporteLocal Float?
  instalacionFecha     DateTime?
  instalacionNotas     String?
  satisfaccionCliente  String?

  // ─── Garantía MOVARA (12 meses) ─────────────────────────────
  garantiaActivada    Boolean   @default(false)
  garantiaFechaInicio DateTime?
  garantiaFechaFin    DateTime? // calculada server-side = garantiaFechaInicio + 12 meses

  documentos DocumentoPedido[]

  @@map("configuraciones_pedido")
}

model DocumentoPedido {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  pedidoId String
  pedido   ConfiguracionPedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  tipo   String // "comprobante_pago" | "pi_proveedor" | "bl" | "otro"
  nombre String // nombre descriptivo del documento
  url    String // path del archivo en Supabase Storage
  notas  String?

  subidoPor String // email del admin/vendedor que lo subió

  @@map("documentos_pedido")
}

model AdminUser {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  nombre      String
  email       String    @unique
  password    String // hash bcrypt
  rol         String    @default("vendedor") // "admin" | "vendedor"
  activo      Boolean   @default(true)
  ultimoLogin DateTime?

  @@map("admin_users")
}

// ─── Agenda de visitas al showroom ──────────────────────────────
model Cita {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fecha   DateTime // fecha del turno, guardada a medianoche UTC (date-only)
  horario String // "10:00" | "11:00" | "12:00" | "15:00" | "16:00" | "17:00"
  estado  String   @default("confirmada") // "confirmada" | "cancelada" | "completada"

  tipoCliente String // "particular" | "empresa"
  nombre      String
  email       String
  telefono    String
  razonSocial String?
  consulta    String // breve descripción de qué busca

  canceladaPor      String? // "cliente" | "admin"
  motivoCancelacion String?

  recordatorioEnviado Boolean @default(false)

  @@index([fecha, horario])
  @@map("citas")
}

model DisponibilidadAgenda {
  id         String   @id @default(cuid())
  fecha      DateTime @unique // date-only, medianoche UTC
  habilitada Boolean  @default(true)
  horarios   String[] // subconjunto de HORARIOS_AGENDA disponible ese día

  @@map("disponibilidad_agenda")
}
